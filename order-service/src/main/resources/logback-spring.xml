<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false">

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="app"/>
    <springProperty scope="context" name="LOG_DIR"  source="logging.file.path"      defaultValue="logs"/>

    <!--
      JSON logging for ALL profiles (default, dev, local, k8s, prod ...).
      One JSON object per line; stack traces are a single escaped string, so exceptions are never
      split across documents.

      Field names match the log-mcp-server defaults and avoid ECS object collisions in the
      filebeat-* template (hence "app_name", not "service"):
        @timestamp, level, app_name, git_sha, trace_id, span_id, thread, logger,
        message, exception_class, stack_trace

      GIT_SHA is read from the environment (set it in the Deployment); defaults to "unknown".
      traceId/spanId are filled into the MDC by Micrometer Tracing.
    -->

    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>@timestamp</fieldName>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <pattern>
                    <pattern>{"app_name":"${APP_NAME}","git_sha":"${GIT_SHA:-unknown}"}</pattern>
                </pattern>
                <mdc>
                    <includeMdcKeyName>traceId</includeMdcKeyName>
                    <includeMdcKeyName>spanId</includeMdcKeyName>
                    <mdcKeyFieldName>traceId=trace_id</mdcKeyFieldName>
                    <mdcKeyFieldName>spanId=span_id</mdcKeyFieldName>
                </mdc>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <loggerName>
                    <fieldName>logger</fieldName>
                    <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
                </loggerName>
                <message>
                    <fieldName>message</fieldName>
                </message>
                <throwableClassName>
                    <fieldName>exception_class</fieldName>
                </throwableClassName>
                <stackTrace>
                    <fieldName>stack_trace</fieldName>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>30</maxDepthPerThrowable>
                        <maxLength>4000</maxLength>
                        <rootCauseFirst>true</rootCauseFirst>
                    </throwableConverter>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <!-- "local" profile: JSON on the console AND in a rolling file on your Mac (file appender lives ONLY here) -->
    <springProfile name="local">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/${APP_NAME}.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>7</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp>
                        <fieldName>@timestamp</fieldName>
                        <timeZone>UTC</timeZone>
                    </timestamp>
                    <logLevel>
                        <fieldName>level</fieldName>
                    </logLevel>
                    <pattern>
                        <pattern>{"app_name":"${APP_NAME}","git_sha":"${GIT_SHA:-unknown}"}</pattern>
                    </pattern>
                    <mdc>
                        <includeMdcKeyName>traceId</includeMdcKeyName>
                        <includeMdcKeyName>spanId</includeMdcKeyName>
                        <mdcKeyFieldName>traceId=trace_id</mdcKeyFieldName>
                        <mdcKeyFieldName>spanId=span_id</mdcKeyFieldName>
                    </mdc>
                    <threadName>
                        <fieldName>thread</fieldName>
                    </threadName>
                    <loggerName>
                        <fieldName>logger</fieldName>
                        <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
                    </loggerName>
                    <message>
                        <fieldName>message</fieldName>
                    </message>
                    <throwableClassName>
                        <fieldName>exception_class</fieldName>
                    </throwableClassName>
                    <stackTrace>
                        <fieldName>stack_trace</fieldName>
                        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                            <maxDepthPerThrowable>30</maxDepthPerThrowable>
                            <maxLength>4000</maxLength>
                            <rootCauseFirst>true</rootCauseFirst>
                        </throwableConverter>
                    </stackTrace>
                </providers>
            </encoder>
        </appender>
        <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>1024</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
            <appender-ref ref="FILE"/>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

    <!-- Every other profile (default, dev, k8s, prod ...): JSON on stdout only, no files -->
    <springProfile name="!local">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>

    <!-- App log level: DEBUG on your machine, INFO everywhere else -->
    <springProfile name="default,dev,local">
        <logger name="com.example" level="DEBUG"/>
    </springProfile>
    <springProfile name="!default &amp; !dev &amp; !local">
        <logger name="com.example" level="INFO"/>
    </springProfile>

    <!-- Noise control -->
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.springframework.kafka" level="INFO"/>

</configuration>